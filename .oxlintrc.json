{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["**/node_modules/**", "**/dist/**", "**/.wrangler/**", "**/.react-router/**", "**/.agents/**"],
  "overrides": [
    {
      "files": ["packages/gameplay/src/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@ks/gameplay/*"],
                "message": "Do not import gameplay public package exports from inside packages/gameplay/src. Import the source module directly."
              },
              {
                "regex": "^\\.\\./(\\.\\./)*contract(/|$)",
                "message": "Do not import packages/gameplay/contract from src. Import the source module directly."
              }
            ]
          }
        ]
      }
    }
  ]
}
