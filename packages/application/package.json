{
  "name": "@ks/application",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts"
  },
  "scripts": {
    "db:generate": "bun ../../tools/generate-migration.mjs ./drizzle --config drizzle.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config ../../apps/play/wrangler.jsonc",
    "db:seed:local": "wrangler d1 execute DB --local --config ../../apps/play/wrangler.jsonc --file ./seeds/local-players.sql",
    "db:studio:local": "KS_D1_LOCAL_URL=$(find ../../apps/play/.wrangler/state/v3/d1/miniflare-D1DatabaseObject -maxdepth 1 -type f -name '*.sqlite' ! -name 'metadata.sqlite' -print -quit) drizzle-kit studio --config drizzle.config.ts --host ${KS_DB_STUDIO_HOST:-127.0.0.1}",
    "test:integration": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@ks/competition": "workspace:*",
    "@ks/core": "workspace:*",
    "@ks/gameplay": "workspace:*",
    "@ks/i18n": "workspace:*",
    "@ks/match-room": "workspace:*",
    "drizzle-orm": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "bun-types": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
