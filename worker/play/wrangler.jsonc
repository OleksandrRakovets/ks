{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ks",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "assets": {
    "binding": "ASSETS",
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
    },
  },
  // Superadmin gate (src/superadmin-access.ts). Cloudflare Access team domain, e.g.
  // "https://<team>.cloudflareaccess.com", and the Access application's Audience (AUD) tag.
  // Empty values reject every /superadmin/ request.
  "vars": {
    "SUPERADMIN_ACCESS_TEAM_DOMAIN": "",
    "SUPERADMIN_ACCESS_AUD": "",
  },
  // Serve only play.ks.ua, behind the superadmin Access application; both are also off in the dashboard.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "play.ks.ua",
      "custom_domain": true,
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MATCH_ROOM",
        "class_name": "MatchRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MatchRoom"],
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ks-prod",
      "database_id": "3a4c6631-3b2b-4a87-be37-e1451830ef3d",
      "migrations_dir": "../../packages/application/drizzle",
      "migrations_pattern": "../../packages/application/drizzle/*/migration.sql",
    },
  ],
}
