# Unversioned public files may stay in browser caches for one week.
/icons/*
  Cache-Control: public, max-age=604800

/games/*
  Cache-Control: public, max-age=604800

# Vite emits content-hashed filenames here, so a deploy never changes an existing URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
