{
  "name": "ks",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*",
      "do/*"
    ],
    "catalog": {
      "@base-ui/react": "^1.8.0",
      "@cloudflare/workers-types": "^5.20260905.1",
      "@types/node": "^26.4.1",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.7",
      "bun-types": "1.4.2",
      "drizzle-kit": "1.0.0-rc.4",
      "drizzle-orm": "1.0.0-rc.4",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "tailwindcss": "^4.3.3",
      "tiny-invariant": "^1.3.3",
      "typescript": "^7.0.2",
      "vite": "^8.2.2",
      "wrangler": "^4.129.0",
      "xstate": "^5.32.6",
      "valibot": "^1.4.2",
      "vitest": "^4.1.11",
      "@cloudflare/vitest-plugin": "^1.1.4"
    }
  },
  "type": "module",
  "scripts": {
    "check": "bun run check:fast",
    "check:fast": "bun run format:check && bun run lint && bun run check:boundaries && bun run typecheck && bun test",
    "check:full": "bun run check:fast && bun run test:integration && bun run build",
    "check:boundaries": "node ./scripts/check-boundaries.mjs",
    "build": "turbo run build --log-order=grouped",
    "db:migrate:local": "bun run --cwd apps/play db:migrate:local",
    "db:seed:local": "bun run --cwd apps/play db:seed:local",
    "db:studio:local": "KS_D1_LOCAL_URL=$(find apps/play/.wrangler/state/v3/d1/miniflare-D1DatabaseObject -maxdepth 1 -type f -name '*.sqlite' ! -name 'metadata.sqlite' -print -quit) drizzle-kit studio --config d1/drizzle.config.ts --host ${KS_DB_STUDIO_HOST:-127.0.0.1}",
    "dev": "turbo watch dev --filter=@ks/play",
    "dev:human": "turbo watch dev --filter=@ks/play --ui=tui",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "machine:explore": "bun --cwd apps/machine-explorer dev",
    "test": "bun test",
    "test:integration": "turbo run test:integration --log-order=grouped",
    "typecheck": "turbo run typecheck --log-order=grouped"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.81.0",
    "bun-types": "catalog:",
    "drizzle-kit": "catalog:",
    "knip": "6.34.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.2",
  "knip": {
    "ignore": [
      "d1/drizzle.config.ts",
      "tools/**"
    ],
    "ignoreDependencies": [
      "@react-router/node",
      "cloudflare"
    ]
  }
}
