{
  "name": "ks",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*",
      "do/*"
    ],
    "catalog": {
      "@babel/core": "^7.29.7",
      "@cloudflare/workers-types": "^4.20260702.1",
      "@rolldown/plugin-babel": "^0.2.3",
      "@types/babel__core": "^7.20.5",
      "@types/node": "^26.2.0",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.4",
      "@vitejs/plugin-react": "^6.0.5",
      "babel-plugin-react-compiler": "^1.0.0",
      "bun-types": "1.3.14",
      "drizzle-kit": "1.0.0-rc.4",
      "drizzle-orm": "1.0.0-rc.4",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "tailwindcss": "^4.3.3",
      "tiny-invariant": "^1.3.3",
      "typescript": "^7.0.2",
      "vite": "^8.2.1",
      "wrangler": "^4.123.0",
      "xstate": "^5.32.5",
      "valibot": "^1.4.2",
      "vitest": "^4.1.11",
      "@cloudflare/vitest-pool-workers": "^0.22.0"
    }
  },
  "type": "module",
  "scripts": {
    "check": "bun run check:fast",
    "check:fast": "bun run format:check && bun run lint && bun run check:boundaries && bun run typecheck && bun test",
    "check:full": "bun run check:fast && bun run test:integration && bun run build",
    "check:boundaries": "node ./scripts/check-boundaries.mjs",
    "build": "turbo run build",
    "db:migrate:local": "bun run --cwd apps/play db:migrate:local",
    "db:seed:local": "bun run --cwd apps/play db:seed:local",
    "db:studio:local": "KS_D1_LOCAL_URL=$(find apps/play/.wrangler/state/v3/d1/miniflare-D1DatabaseObject -maxdepth 1 -type f -name '*.sqlite' ! -name 'metadata.sqlite' -print -quit) drizzle-kit studio --config d1/drizzle.config.ts --host ${KS_DB_STUDIO_HOST:-127.0.0.1}",
    "dev": "turbo watch dev --filter=@ks/play",
    "dev:human": "turbo watch dev --filter=@ks/play --ui=tui",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "machine:explore": "bun --cwd apps/machine-explorer dev",
    "test": "bun test",
    "test:integration": "turbo run test:integration",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "bun-types": "catalog:",
    "drizzle-kit": "catalog:",
    "knip": "6.32.2",
    "oxfmt": "^0.62.0",
    "oxlint": "1.78.0",
    "turbo": "^2.10.10",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.14",
  "knip": {
    "ignore": [
      "d1/drizzle.config.ts",
      "tools/oxlint/anti-slop/effect/**"
    ],
    "ignoreDependencies": [
      "@react-router/node",
      "cloudflare"
    ]
  }
}
