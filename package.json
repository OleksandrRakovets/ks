{
  "name": "ks",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*",
      "do/*"
    ],
    "catalog": {
      "@base-ui/react": "^1.8.0",
      "@cloudflare/workers-types": "^5.20260927.1",
      "@types/node": "^26.6.3",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "bun-types": "1.4.2",
      "drizzle-kit": "1.0.0-rc.4",
      "drizzle-orm": "1.0.0-rc.4",
      "react": "^19.3.0",
      "react-dom": "^19.3.0",
      "tailwindcss": "^4.3.3",
      "typescript": "7.0.2",
      "vite": "^8.3.1",
      "wrangler": "^4.142.0",
      "xstate": "^5.33.2",
      "valibot": "^1.5.0",
      "vitest": "^4.1.11",
      "@cloudflare/vitest-plugin": "^1.3.0"
    }
  },
  "type": "module",
  "scripts": {
    "check": "bun run check:fast",
    "check:fast": "bun run format && bun run typecheck && bun run lint && bun run check:boundaries && bun test",
    "check:full": "bun run check:fast && bun run test:integration && bun run build",
    "check:boundaries": "node ./tools/check-boundaries.mjs",
    "build": "turbo run build --log-order=grouped",
    "db:generate:d1": "bun ./tools/generate-migration.mjs packages/application/d1/migrations --config packages/application/d1/drizzle.config.ts",
    "db:generate:match-room": "bun ./tools/generate-migration.mjs do/match-room/drizzle --config do/match-room/drizzle.config.ts",
    "db:migrate:local": "bun run --cwd apps/play db:migrate:local",
    "db:reset:local": "bun ./tools/reset-local.mjs",
    "db:seed:local": "bun run --cwd apps/play db:seed:local",
    "db:studio:local": "KS_D1_LOCAL_URL=$(find apps/play/.wrangler/state/v3/d1/miniflare-D1DatabaseObject -maxdepth 1 -type f -name '*.sqlite' ! -name 'metadata.sqlite' -print -quit) drizzle-kit studio --config packages/application/d1/drizzle.config.ts --host ${KS_DB_STUDIO_HOST:-127.0.0.1}",
    "dev": "BUN_OPTIONS=--silent turbo watch @ks/play#dev",
    "dev:human": "BUN_OPTIONS=--silent turbo watch @ks/play#dev --ui=tui",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "preview": "BUN_OPTIONS=--silent turbo run @ks/play#preview",
    "test": "bun test",
    "test:integration": "turbo run test:integration --log-order=grouped",
    "typecheck": "bun run typegen && tsc --build",
    "typegen": "bun run --filter '@ks/play' typegen"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.85.0",
    "bun-types": "catalog:",
    "drizzle-kit": "catalog:",
    "knip": "6.38.0",
    "oxfmt": "^0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "turbo": "^2.11.4",
    "typescript": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2"
    }
  },
  "knip": {
    "ignore": [
      "packages/application/d1/drizzle.config.ts",
      "do/match-room/drizzle/migrations.d.ts",
      "tools/**"
    ],
    "ignoreDependencies": [
      "@react-router/node",
      "cloudflare"
    ]
  }
}
