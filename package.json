{
  "name": "ks",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "@babel/core": "^7.29.0",
      "@rolldown/plugin-babel": "^0.2.3",
      "@types/babel__core": "^7.20.5",
      "@types/react": "^19.2.14",
      "@types/react-dom": "^19.2.3",
      "@vitejs/plugin-react": "^6.0.2",
      "babel-plugin-react-compiler": "^1.0.0",
      "react": "^19.2.6",
      "react-dom": "^19.2.6",
      "tailwindcss": "^4.3.0",
      "tiny-invariant": "^1.3.3",
      "typescript": "^6.0.3",
      "vite": "^8.0.13",
      "xstate": "^5.31.1",
      "valibot": "^1.4.1"
    }
  },
  "scripts": {
    "check:boundaries": "node ./scripts/check-boundaries.mjs",
    "build": "turbo run build",
    "db:migrate:local": "bun run --cwd apps/play db:migrate:local",
    "dev": "turbo run dev --filter=@ks/play",
    "dev:human": "turbo run dev --filter=@ks/play --ui=tui",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "machine:explore": "bun --cwd apps/machine-explorer dev",
    "test": "bun test",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "bun-types": "latest",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.69.0",
    "tailwindcss": "^4.3.1",
    "turbo": "^2.9.18",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.3.14"
}
