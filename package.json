{
  "name": "ks",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*",
      "do/*"
    ],
    "catalog": {
      "@babel/core": "^7.29.7",
      "@cloudflare/workers-types": "^4.20260702.1",
      "@rolldown/plugin-babel": "^0.2.3",
      "@types/babel__core": "^7.20.5",
      "@types/node": "^26.2.0",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.4",
      "@vitejs/plugin-react": "^6.0.5",
      "babel-plugin-react-compiler": "^1.0.0",
      "bun-types": "1.3.14",
      "drizzle-kit": "1.0.0-rc.4",
      "drizzle-orm": "1.0.0-rc.4",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "tailwindcss": "^4.3.3",
      "tiny-invariant": "^1.3.3",
      "typescript": "^6.0.3",
      "vite": "^8.2.1",
      "wrangler": "^4.123.0",
      "xstate": "^5.32.5",
      "valibot": "^1.4.2"
    }
  },
  "type": "module",
  "scripts": {
    "check": "bun run format:check && bun run lint && bun run check:boundaries && bun run typecheck && bun test",
    "check:boundaries": "node ./scripts/check-boundaries.mjs",
    "build": "turbo run build",
    "db:migrate:local": "bun run --cwd apps/play db:migrate:local",
    "db:seed:local": "bun run --cwd apps/play db:seed:local",
    "dev": "turbo watch dev --filter=@ks/play",
    "dev:human": "turbo watch dev --filter=@ks/play --ui=tui",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "machine:explore": "bun --cwd apps/machine-explorer dev",
    "test": "bun test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "bun-types": "catalog:",
    "drizzle-kit": "catalog:",
    "oxfmt": "^0.62.0",
    "oxlint": "1.78.0",
    "tailwindcss": "catalog:",
    "turbo": "^2.10.10",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.14"
}
