{
  "name": "ks",
  "private": true,
  "workspaces": [
    "packages/*",
    "clients/*"
  ],
  "scripts": {
    "dev": "PATH=\"$HOME/.bun/bin:$PATH\" bun run --cwd clients/rr7 dev",
    "test": "bun test",
    "typecheck": "tsc -b",
    "check:boundaries": "node ./scripts/check-boundaries.mjs",
    "check:zod": "node ./scripts/check-zod.mjs",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "oxfmt": "latest",
    "oxlint": "latest",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "zod": "4.3.6"
  }
}
