{
  "name": "ks",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "worker/*",
      "do/*"
    ],
    "catalog": {
      "@base-ui/react": "^1.9.0",
      "@cloudflare/workers-types": "^5.20261102.1",
      "@types/node": "^26.6.6",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "bun-types": "1.4.4",
      "drizzle-kit": "1.0.0-rc.4",
      "drizzle-orm": "1.0.0-rc.4",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "tailwindcss": "^4.3.3",
      "typescript": "7.0.2",
      "vite": "^8.3.5",
      "wrangler": "^4.156.0",
      "xstate": "^5.33.3",
      "valibot": "^1.5.0",
      "vitest": "^5.0.5",
      "@cloudflare/vitest-plugin": "^1.4.11"
    }
  },
  "type": "module",
  "scripts": {
    "check": "bun run check:fast",
    "check:fast": "bun run format && bun run typecheck && bun run lint && bun run test",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "turbo run test --log-order=grouped --output-logs=errors-only",
    "typecheck": "bun run typegen && tsc --build",
    "typegen": "bun run --filter '*' typegen",
    "play:check:full": "bun run check:fast && turbo run test:integration build --filter=@ks/play... --log-order=grouped",
    "play:build": "turbo run build --filter=@ks/play... --log-order=grouped",
    "play:dev": "BUN_OPTIONS=--silent turbo watch @ks/play#dev",
    "play:dev:human": "BUN_OPTIONS=--silent turbo watch @ks/play#dev --ui=tui",
    "play:preview": "BUN_OPTIONS=--silent turbo run @ks/play#preview",
    "play:db:reset:local": "bun ./tools/reset-play-local.mjs",
    "play:test:integration": "turbo run test:integration --filter=@ks/play... --log-order=grouped",
    "play:test:e2e": "turbo run test:e2e --filter=@ks/play-e2e --log-order=grouped",
    "play:test:e2e:webkit": "turbo run test:e2e:webkit --filter=@ks/play-e2e --log-order=grouped"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.90.0",
    "@types/node": "catalog:",
    "bun-types": "catalog:",
    "knip": "^6.44.1",
    "oxfmt": "^0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "turbo": "^2.11.10",
    "typescript": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4"
    }
  },
  "knip": {
    "workspaces": {
      "worker/play": {
        "project": [
          "**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts}!",
          "**/*.css!",
          "!src/web/features/freshness/test-browser.ts!"
        ]
      },
      "packages/play-e2e": {
        "project": [
          "**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts}!",
          "!scripts/ensure-browser.ts!",
          "!test/browser.ts!",
          "!test/native-browser.ts!",
          "!test/server.ts!"
        ],
        "ignoreDependencies": [
          "@ks/play",
          "wrangler"
        ]
      },
      "do/match-room": {
        "project": [
          "**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts}!",
          "!test/rpc/fixtures.ts!",
          "!drizzle/migrations.d.ts"
        ]
      },
      "packages/application": {
        "project": [
          "**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts}!",
          "!src/sparring/sparring.fixtures.ts!"
        ]
      }
    },
    "ignore": [
      "tools/**"
    ],
    "ignoreDependencies": [
      "@react-router/node",
      "cloudflare"
    ]
  }
}
