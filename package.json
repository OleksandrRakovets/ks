{
  "name": "ks",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "worker/*",
      "do/*"
    ],
    "catalog": {
      "@base-ui/react": "^1.9.0",
      "@cloudflare/workers-types": "^5.20261016.1",
      "@types/node": "^26.6.5",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "bun-types": "1.4.4",
      "drizzle-kit": "1.0.0-rc.4",
      "drizzle-orm": "1.0.0-rc.4",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "tailwindcss": "^4.3.3",
      "typescript": "7.0.2",
      "vite": "^8.3.5",
      "wrangler": "^4.151.3",
      "xstate": "^5.33.3",
      "valibot": "^1.5.0",
      "vitest": "^5.0.5",
      "@cloudflare/vitest-plugin": "^1.4.6"
    }
  },
  "type": "module",
  "scripts": {
    "check": "bun run check:fast",
    "check:fast": "bun run format && bun run typecheck && bun run lint && bun run check:boundaries && bun test",
    "check:full": "bun run check:fast && bun run test:integration && bun run build",
    "check:boundaries": "node ./tools/check-boundaries.mjs",
    "build": "turbo run build --log-order=grouped",
    "db:reset:local": "bun ./tools/reset-local.mjs",
    "dev": "BUN_OPTIONS=--silent turbo watch @ks/play#dev",
    "dev:human": "BUN_OPTIONS=--silent turbo watch @ks/play#dev --ui=tui",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "preview": "BUN_OPTIONS=--silent turbo run @ks/play#preview",
    "test": "bun test",
    "test:integration": "turbo run test:integration --log-order=grouped",
    "test:e2e": "turbo run test:e2e --log-order=grouped",
    "test:e2e:webkit": "turbo run test:e2e:webkit --log-order=grouped",
    "typecheck": "bun run typegen && tsc --build",
    "typegen": "bun run --filter '@ks/play' typegen"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.89.0",
    "@types/node": "catalog:",
    "bun-types": "catalog:",
    "knip": "^6.42.1",
    "oxfmt": "^0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "turbo": "^2.11.10",
    "typescript": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4"
    }
  },
  "knip": {
    "workspaces": {
      "worker/play": {
        "project": [
          "**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts}!",
          "**/*.css!",
          "!src/web/features/freshness/test-browser.ts!"
        ]
      },
      "packages/e2e": {
        "project": [
          "**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts}!",
          "!scripts/ensure-browser.ts!",
          "!test/browser.ts!",
          "!test/native-browser.ts!",
          "!test/server.ts!"
        ],
        "ignoreDependencies": [
          "@ks/play",
          "wrangler"
        ]
      },
      "do/match-room": {
        "project": [
          "**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts}!",
          "!test/rpc/fixtures.ts!",
          "!drizzle/migrations.d.ts"
        ]
      },
      "packages/application": {
        "project": [
          "**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts}!",
          "!src/sparring/sparring.fixtures.ts!"
        ]
      }
    },
    "ignore": [
      "tools/**"
    ],
    "ignoreDependencies": [
      "@react-router/node",
      "cloudflare"
    ]
  }
}
