#!/usr/bin/env bash
set -euo pipefail

readonly NODE_VERSION="26.5.0"
readonly NODE_SHA256="9f619528f1db5ddc41dccf54211066fb42228d69a156733c69cb9d6cc92e358c"
readonly BUN_VERSION="1.3.14"
readonly BUN_SHA256="951ee2aee855f08595aeec6225226a298d3fea83a3dcd6465c09cbccdf7e848f"

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
local_bin="${HOME}/.local/bin"
local_share="${HOME}/.local/share"

if [[ "$(uname -m)" != "x86_64" ]]; then
  echo "Unsupported architecture: $(uname -m) (expected x86_64)" >&2
  exit 1
fi

mkdir -p "$local_bin" "$local_share"

install_node() {
  local install_dir="${local_share}/node-v${NODE_VERSION}"

  if [[ ! -x "${install_dir}/bin/node" ]]; then
    echo "Installing Node.js v${NODE_VERSION}..."
    local temp_dir archive
    temp_dir="$(mktemp -d)"
    archive="${temp_dir}/node.tar.xz"
    curl --fail --location --silent --show-error \
      "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
      --output "$archive"
    echo "${NODE_SHA256}  ${archive}" | sha256sum --check --status
    mkdir -p "$install_dir"
    tar -xJf "$archive" --strip-components=1 -C "$install_dir"
    rm -rf "$temp_dir"
  fi

  for command in node npm npx corepack; do
    ln -sfn "${install_dir}/bin/${command}" "${local_bin}/${command}"
  done
}

install_bun() {
  local declared_version install_dir
  declared_version="$(python3 -c 'import json; print(json.load(open("package.json"))["packageManager"].removeprefix("bun@"))')"
  if [[ "$declared_version" != "$BUN_VERSION" ]]; then
    echo "Update .agents/setup for packageManager bun@${declared_version}; it currently pins bun@${BUN_VERSION}." >&2
    exit 1
  fi

  install_dir="${local_share}/bun-v${BUN_VERSION}"
  if [[ ! -x "${install_dir}/bun" ]]; then
    echo "Installing Bun v${BUN_VERSION}..."
    local temp_dir archive
    temp_dir="$(mktemp -d)"
    archive="${temp_dir}/bun.zip"
    curl --fail --location --silent --show-error \
      "https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}/bun-linux-x64.zip" \
      --output "$archive"
    echo "${BUN_SHA256}  ${archive}" | sha256sum --check --status
    unzip -q "$archive" -d "$temp_dir"
    mkdir -p "$install_dir"
    install -m 0755 "${temp_dir}/bun-linux-x64/bun" "${install_dir}/bun"
    rm -rf "$temp_dir"
  fi

  ln -sfn "${install_dir}/bun" "${local_bin}/bun"
  ln -sfn "${install_dir}/bun" "${local_bin}/bunx"
}

cd "$repo_root"
install_node
install_bun
export PATH="${local_bin}:${PATH}"

echo "Using $(node --version) and Bun $(bun --version)."

if [[ ! -f apps/play/.dev.vars ]]; then
  cp -- apps/play/.dev.vars.example apps/play/.dev.vars
fi

echo "Installing workspace dependencies..."
bun install --frozen-lockfile

echo "Applying local D1 migrations..."
CI=1 bun run db:migrate:local

echo "Orb setup complete. Start development with: bun run dev"
