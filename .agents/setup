#!/usr/bin/env bash
set -euo pipefail

readonly NODE_MAJOR="26"

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
local_bin="${HOME}/.local/bin"
local_share="${HOME}/.local/share"

if [[ "$(uname -m)" != "x86_64" ]]; then
  echo "Unsupported architecture: $(uname -m) (expected x86_64)" >&2
  exit 1
fi

mkdir -p "$local_bin" "$local_share"

install_node() {
  local current
  if [[ -x "${local_bin}/node" ]]; then
    current="$("${local_bin}/node" --version)"
    if [[ "${current}" == "v${NODE_MAJOR}."* ]]; then
      echo "Node ${current} already installed."
      return
    fi
    echo "Node ${current} installed, wanted v${NODE_MAJOR}.x — upgrading..."
  fi

  # Latest patch of the pinned major; no SHA pin (HTTPS is the integrity check).
  local version install_dir
  version="$(curl --fail --location --silent --show-error https://nodejs.org/dist/index.json \
    | NODE_MAJOR="${NODE_MAJOR}" python3 -c 'import json,os,sys; print(next(e["version"].removeprefix("v") for e in json.load(sys.stdin) if e["version"].startswith("v" + os.environ["NODE_MAJOR"] + ".") and "-" not in e["version"]))')"
  install_dir="${local_share}/node-v${version}"

  if [[ ! -x "${install_dir}/bin/node" ]]; then
    echo "Installing Node.js v${version}..."
    local temp_dir archive
    temp_dir="$(mktemp -d)"
    archive="${temp_dir}/node.tar.xz"
    curl --fail --location --silent --show-error \
      "https://nodejs.org/dist/v${version}/node-v${version}-linux-x64.tar.xz" \
      --output "$archive"
    mkdir -p "$install_dir"
    tar -xJf "$archive" --strip-components=1 -C "$install_dir"
    rm -rf "$temp_dir"
  fi

  for command in node npm npx corepack; do
    ln -sfn "${install_dir}/bin/${command}" "${local_bin}/${command}"
  done
}

install_bun() {
  # Only the major.minor of packageManager is enforced; patch floats (rolling).
  # Installs via the official script (see bun.sh/docs/installation) with
  # BUN_INSTALL pinned to a versioned dir. HOME is faked so the script never
  # touches real shell rc files (we manage PATH via local_bin symlinks).
  local declared_minor
  declared_minor="$(python3 -c 'import json; print(".".join(json.load(open("package.json"))["packageManager"].removeprefix("bun@").split(".")[:2]))')"

  local current
  if [[ -x "${local_bin}/bun" ]]; then
    current="$("${local_bin}/bun" --version)"
    if [[ "${current%.*}" == "${declared_minor}" ]]; then
      echo "Bun ${current} already installed (wanted ${declared_minor}.x)."
      return
    fi
    echo "Bun ${current} installed, wanted ${declared_minor}.x — upgrading..."
  fi

  # Resolve latest release tag first so a minor bump fails before downloading.
  local tag version install_dir fake_home
  tag="$(curl --fail --location --silent --show-error --output /dev/null --write-out '%{url_effective}' https://github.com/oven-sh/bun/releases/latest)"
  version="${tag##*/bun-v}"
  if [[ "${version%.*}" != "${declared_minor}" ]]; then
    echo "Latest Bun is ${version}, but package.json wants ${declared_minor}.x — update packageManager." >&2
    exit 1
  fi

  install_dir="${local_share}/bun-v${version}"
  if [[ ! -x "${install_dir}/bin/bun" ]]; then
    echo "Installing Bun v${version}..."
    fake_home="$(mktemp -d)"
    curl --fail --location --silent --show-error https://bun.com/install \
      | HOME="${fake_home}" BUN_INSTALL="${install_dir}" bash -s "bun-v${version}"
    rm -rf "${fake_home}"
  fi

  ln -sfn "${install_dir}/bin/bun" "${local_bin}/bun"
  ln -sfn "${install_dir}/bin/bun" "${local_bin}/bunx"
}

cd "$repo_root"
install_node
install_bun
export PATH="${local_bin}:${PATH}"

echo "Using $(node --version) and Bun $(bun --version)."

if [[ ! -f apps/play/.dev.vars ]]; then
  cp -- apps/play/.dev.vars.example apps/play/.dev.vars
fi

echo "Installing workspace dependencies..."
bun install --frozen-lockfile

echo "Applying local D1 migrations..."
CI=1 bun run db:migrate:local

echo "Orb setup complete. Start development with: bun run dev"
