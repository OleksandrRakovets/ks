#!/usr/bin/env bash
set -euo pipefail

readonly ROBOTO_RELEASE_TAG="v3.016"
readonly ROBOTO_ARCHIVE_SHA256="1653dbe12f248da8fb0b9920db7b9496cd677ed3981154f6f15285c8bd4e334f"
readonly ROBOTO_FONT_SHA256="07f56c49cba5aa0c36f0c8295ffe2e39578e8459a743a7a619ad094b483ba857"
readonly ROBOTO_ARCHIVE_URL="https://github.com/googlefonts/roboto-3-classic/releases/download/${ROBOTO_RELEASE_TAG}/Roboto_${ROBOTO_RELEASE_TAG}.zip"
readonly OXLINT_SWAP_FILE="/swapfile.ks-oxlint"
readonly OXLINT_SWAP_SIZE="8G"

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
local_bin="${HOME}/.local/bin"
local_share="${HOME}/.local/share"
setup_marker="${repo_root}/.amp/setup-complete"

mkdir -p "${repo_root}/.amp"
rm -f "$setup_marker"

if [[ "$(uname -m)" != "x86_64" ]]; then
  echo "Unsupported architecture: $(uname -m) (expected x86_64)" >&2
  exit 1
fi

mkdir -p "$local_bin" "$local_share"

enable_oxlint_swap() {
  if awk -v path="$OXLINT_SWAP_FILE" '$1 == path { found = 1 } END { exit !found }' /proc/swaps; then
    echo "Oxlint swap is already active."
    return
  fi

  # Oxlint JS plugins reserve several GiB of virtual memory per allocator. Small
  # orbs need swap-backed commit headroom, although linting does not use the swap.
  echo "Creating ${OXLINT_SWAP_SIZE} of swap for Oxlint..."
  sudo -n rm -f -- "$OXLINT_SWAP_FILE"
  sudo -n fallocate -l "$OXLINT_SWAP_SIZE" "$OXLINT_SWAP_FILE"
  sudo -n chmod 600 "$OXLINT_SWAP_FILE"
  sudo -n /sbin/mkswap "$OXLINT_SWAP_FILE"
  if ! sudo -n /sbin/swapon "$OXLINT_SWAP_FILE"; then
    sudo -n rm -f -- "$OXLINT_SWAP_FILE"
    return 1
  fi
}

install_bun() {
  # The declared version is a minimum; keep an equal or newer installed Bun.
  # Installs via the official script (see bun.sh/docs/installation) with
  # BUN_INSTALL pinned to a versioned dir. HOME is faked so the script never
  # touches real shell rc files (we manage PATH via local_bin symlinks).
  local version
  version="$(python3 -c 'import json; print(json.load(open("package.json"))["devEngines"]["packageManager"]["version"])')"

  local current
  if [[ -x "${local_bin}/bun" ]]; then
    current="$("${local_bin}/bun" --version)"
    if [[ "$(printf '%s\n' "$version" "$current" | sort -V | head -n 1)" == "$version" ]]; then
      echo "Bun ${current} already installed (minimum ${version})."
      return
    fi
    echo "Bun ${current} installed, minimum ${version} — upgrading..."
  fi

  local install_dir fake_home
  install_dir="${local_share}/bun-v${version}"
  if [[ ! -x "${install_dir}/bin/bun" ]]; then
    echo "Installing Bun v${version}..."
    fake_home="$(mktemp -d)"
    curl --fail --location --silent --show-error https://bun.com/install \
      | HOME="${fake_home}" BUN_INSTALL="${install_dir}" bash -s "bun-v${version}"
    rm -rf "${fake_home}"
  fi

  ln -sfn "${install_dir}/bin/bun" "${local_bin}/bun"
  ln -sfn "${install_dir}/bin/bun" "${local_bin}/bunx"
}

install_roboto() {
  if [[ "$(uname -s)" != "Linux" ]]; then
    echo "Skipping Linux Roboto installation on $(uname -s)."
    return
  fi

  local font_dir font_file font_version_file fontconfig_dir fontconfig_file temp_dir archive extracted installed_version font_is_current
  font_dir="${XDG_DATA_HOME:-${HOME}/.local/share}/fonts"
  font_file="${font_dir}/Roboto-Android.ttf"
  font_version_file="${font_dir}/.ks-roboto-version"
  fontconfig_dir="${XDG_CONFIG_HOME:-${HOME}/.config}/fontconfig"
  fontconfig_file="${fontconfig_dir}/fonts.conf"
  mkdir -p "$font_dir" "$fontconfig_dir"

  installed_version=''
  if [[ -f "$font_version_file" ]]; then
    installed_version="$(< "$font_version_file")"
  fi
  font_is_current=false
  if [[ -s "$font_file" && "$installed_version" == "$ROBOTO_RELEASE_TAG" ]] &&
    printf '%s  %s\n' "$ROBOTO_FONT_SHA256" "$font_file" | sha256sum --check --status -; then
    font_is_current=true
  fi
  if [[ "$font_is_current" != true ]]; then
    echo "Installing Android Roboto ${ROBOTO_RELEASE_TAG}..."
    temp_dir="$(mktemp -d)"
    trap 'rm -rf -- "${temp_dir}"' EXIT
    archive="${temp_dir}/Roboto.zip"
    extracted="${temp_dir}/Roboto-Android.ttf"
    curl --fail --location --silent --show-error "$ROBOTO_ARCHIVE_URL" --output "$archive"
    printf '%s  %s\n' "$ROBOTO_ARCHIVE_SHA256" "$archive" | sha256sum --check --status -
    unzip -p "$archive" 'android/Roboto\[ital,wdth,wght\].ttf' > "$extracted"
    if [[ ! -s "$extracted" ]]; then
      echo "Roboto archive did not contain the Android variable font." >&2
      rm -rf "$temp_dir"
      exit 1
    fi
    printf '%s  %s\n' "$ROBOTO_FONT_SHA256" "$extracted" | sha256sum --check --status -
    mv -- "$extracted" "$font_file"
    printf '%s\n' "$ROBOTO_RELEASE_TAG" > "$font_version_file"
    trap - EXIT
    rm -rf "$temp_dir"
  fi

  local fontconfig_block_start='  <!-- ks-roboto-start -->'
  if [[ ! -f "$fontconfig_file" ]]; then
    cat > "$fontconfig_file" <<'EOF'
<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<fontconfig>
  <!-- ks-roboto-start -->
  <alias>
    <family>sans-serif</family>
    <prefer><family>Roboto</family></prefer>
  </alias>
  <alias>
    <family>system-ui</family>
    <prefer><family>Roboto</family></prefer>
  </alias>
  <alias>
    <family>ui-sans-serif</family>
    <prefer><family>Roboto</family></prefer>
  </alias>
  <!-- ks-roboto-end -->
</fontconfig>
EOF
  elif ! grep --fixed-strings --quiet "$fontconfig_block_start" "$fontconfig_file"; then
    FONTCONFIG_FILE="$fontconfig_file" python3 - <<'PY'
from pathlib import Path
import os
import tempfile

path = Path(os.environ["FONTCONFIG_FILE"])
text = path.read_text()
closing = "</fontconfig>"
block = """  <!-- ks-roboto-start -->
  <alias>
    <family>sans-serif</family>
    <prefer><family>Roboto</family></prefer>
  </alias>
  <alias>
    <family>system-ui</family>
    <prefer><family>Roboto</family></prefer>
  </alias>
  <alias>
    <family>ui-sans-serif</family>
    <prefer><family>Roboto</family></prefer>
  </alias>
  <!-- ks-roboto-end -->
"""
if closing not in text:
    raise SystemExit(f"Fontconfig file has no {closing}: {path}")
mode = path.stat().st_mode & 0o777
fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
try:
    with os.fdopen(fd, "w", encoding="utf-8") as output:
        output.write(text.replace(closing, block + closing, 1))
    os.chmod(temporary, mode)
    os.replace(temporary, path)
except BaseException:
    try:
        os.unlink(temporary)
    except FileNotFoundError:
        pass
    raise
PY
  fi

  fc-cache -f "$font_dir"
  local family resolved_font
  for family in system-ui sans-serif ui-sans-serif; do
    resolved_font="$(fc-match -f '%{family}|%{file}' "$family")"
    if [[ "$resolved_font" != "Roboto|${font_file}" ]]; then
      echo "Roboto installed, but ${family} resolves to ${resolved_font}." >&2
      exit 1
    fi
  done
  echo "Using Roboto for Linux system UI."
}

cd "$repo_root"
enable_oxlint_swap
install_roboto
install_bun
export PATH="${local_bin}:${PATH}"

echo "Using $(node --version) and Bun $(bun --version)."

echo "Installing workspace dependencies..."
bun install --frozen-lockfile

# A refreshed orb can inherit ignored Wrangler state from an older project snapshot.
# Only discard local D1 when its applied migration history no longer belongs to this checkout.
stale_d1="$(python3 - <<'PY'
from pathlib import Path
import sqlite3

migrations = Path('packages/application/drizzle')
expected = {str(path.relative_to(migrations)) for path in migrations.glob('*/migration.sql')}
databases = Path('apps/play/.wrangler/state/v3/d1/miniflare-D1DatabaseObject').glob('*.sqlite')
for path in databases:
    if path.name == 'metadata.sqlite':
        continue
    with sqlite3.connect(f'file:{path}?mode=ro', uri=True) as db:
        tables = {row[0] for row in db.execute("SELECT name FROM sqlite_master WHERE type = 'table'")}
        applied = {row[0] for row in db.execute('SELECT name FROM d1_migrations')} if 'd1_migrations' in tables else set()
        if applied - expected or ('d1_migrations' not in tables and tables - {'_cf_METADATA', 'sqlite_sequence'}):
            print('yes')
            break
PY
)"
if [[ "$stale_d1" == yes ]]; then
  echo "Discarding stale local D1 state from an older orb snapshot..."
  rm -rf -- apps/play/.wrangler/state/v3/d1
fi

echo "Applying local D1 migrations..."
CI=1 bun run --cwd packages/application db:migrate:local

setup_checksum="$(sha256sum "${repo_root}/.agents/setup")"
printf '%s\n' "${setup_checksum%% *}" > "$setup_marker"

echo "Orb setup complete. Start development with: bun run dev"
