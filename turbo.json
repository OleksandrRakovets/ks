{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "noUpdateNotifier": true,
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "description": "Keep ^build so source-only workspace transit nodes propagate their file hashes without running build scripts.",
      "dependsOn": ["^build"],
      "outputs": ["build/**", "dist/**"]
    },
    "typegen": {
      "description": "Wrangler reads .dev.vars and .env files for secret types; Turbo skips gitignored files unless listed.",
      "inputs": ["$TURBO_DEFAULT$", ".dev.vars*", ".env*"],
      "outputs": ["worker-configuration.d.ts", ".react-router/types/**"]
    },
    "transit": {
      "description": "Dependency hashes for tasks that must not wait on dependencies' runs.",
      "dependsOn": ["^transit"]
    },
    "test": {
      "description": "Reruns when a dependency changes (through transit) without waiting for its tests.",
      "dependsOn": ["transit"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^test:integration"],
      "outputs": []
    },
    "@ks/match-room#test:integration": {
      "dependsOn": ["^test:integration"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/worker/play/wrangler.jsonc"],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "test:e2e:webkit": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@ks/play#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["BUN_OPTIONS"]
    },
    "@ks/play#preview": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["BUN_OPTIONS"]
    }
  }
}
