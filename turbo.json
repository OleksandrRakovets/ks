{
  "$schema": "https://turborepo.com/schema.json",
  "noUpdateNotifier": true,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "//#check": {
      "cache": false,
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@ks/play#build": {
      "dependsOn": ["//#check"],
      "outputs": ["build/**", ".react-router/**"]
    },
    "@ks/match-room#build": {
      "dependsOn": ["//#check"],
      "outputs": ["dist/**"]
    },
    "machine-explorer#build": {
      "outputs": ["dist/**"]
    },
    "@ks/play#dev": {
      "cache": false,
      "persistent": true
    }
  }
}
