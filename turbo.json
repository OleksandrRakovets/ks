{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "noUpdateNotifier": true,
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@ks/play#build": {
      "description": "Package-specific tasks replace defaults. Keep ^build so source-only workspace transit nodes propagate their file hashes without running build scripts.",
      "dependsOn": ["^build"],
      "outputs": ["build/**"]
    },
    "test": {
      "description": "^test chains dependency hashes, so a change in a dependency reruns its consumers' unit tests.",
      "dependsOn": ["^test"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/bunfig.toml"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^test:integration"],
      "outputs": []
    },
    "@ks/match-room#test:integration": {
      "dependsOn": ["^test:integration"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/worker/play/wrangler.jsonc"],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "test:e2e:webkit": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@ks/play#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["BUN_OPTIONS"]
    },
    "@ks/play#preview": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["BUN_OPTIONS"]
    }
  }
}
