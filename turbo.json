{
  "$schema": "https://turborepo.com/schema.json",
  "noUpdateNotifier": true,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^test:integration"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@ks/play#build": {
      "outputs": ["build/**"]
    },
    "@ks/play#dev": {
      "cache": false,
      "persistent": true
    }
  }
}
