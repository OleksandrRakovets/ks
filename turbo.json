{
  "$schema": "https://turborepo.com/schema.json",
  "noUpdateNotifier": true,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^test:integration"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@ks/play#build": {
      "outputs": ["build/**"]
    },
    "@ks/play#typecheck": {
      "outputs": [".react-router/types/**", "worker-configuration.d.ts"]
    },
    "@ks/match-room#build": {
      "outputs": ["dist/**"]
    },
    "@ks/match-room#typecheck": {
      "outputs": ["worker-configuration.d.ts"]
    },
    "@ks/play#dev": {
      "cache": false,
      "persistent": true
    }
  }
}
