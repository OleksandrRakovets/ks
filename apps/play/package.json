    "class-variance-authority": "^0.7.1",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "i18next": "^26.4.0",
    "isbot": "^5.2.1",
    "radix-ui": "^1.6.7",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "^17.0.12",
    "react-router": "^8.3.0",
    "shadcn": "^4.19.0",
