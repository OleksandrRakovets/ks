{
  "name": "@ks/play",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "db:migrate:local": "wrangler d1 migrations apply ks --local",
    "db:seed:local": "wrangler d1 execute ks --local --file ../../d1/seeds/local-players.sql",
    "build": "react-router build",
    "preview": "react-router build && vite preview",
    "cf-typegen": "wrangler types --config wrangler.jsonc --config ../../do/match-room/wrangler.jsonc",
    "typecheck": "wrangler types --config wrangler.jsonc --config ../../do/match-room/wrangler.jsonc && react-router typegen && tsc -b"
  },
