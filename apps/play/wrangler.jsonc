{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ks",
  "main": "workers/app.ts",
  "compatibility_date": "2026-08-11",
  "durable_objects": {
    "bindings": [{ "name": "MATCH_ROOM", "class_name": "MatchRoom", "script_name": "ks-match-room" }],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ks",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations",
    },
  ],
}
