{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ks",
  "main": "workers/app.ts",
  "compatibility_date": "2026-08-11",
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
    },
  },
  "routes": [
    {
      "pattern": "play.ks.ua",
      "custom_domain": true,
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MATCH_ROOM",
        "class_name": "MatchRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MatchRoom"],
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ks-prod",
      "database_id": "3a4c6631-3b2b-4a87-be37-e1451830ef3d",
      "migrations_dir": "../../d1/migrations",
      "migrations_pattern": "../../d1/migrations/*/migration.sql",
    },
  ],
}
